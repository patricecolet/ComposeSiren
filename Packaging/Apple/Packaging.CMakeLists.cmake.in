################################################################################
# configure post installer build scripts

# set these for calls to configure_file below :
set(MAIN_BINARY_DIR "@CMAKE_CURRENT_BINARY_DIR@")
set(BaseTargetName "@BaseTargetName@")
set(VendorName "@VendorName@")
set(APPLE_DEVELOPER_ID_APPLICATION "@APPLE_DEVELOPER_ID_APPLICATION@")
set(APPLE_DEVELOPER_ID_INSTALLER "@APPLE_DEVELOPER_ID_INSTALLER@")
set(APPLE_NOTARIZATION_KEYCHAIN_PROFILE "@APPLE_NOTARIZATION_KEYCHAIN_PROFILE@")
set(PACKAGING_SCRIPTS_DIR "@PACKAGING_SCRIPTS_DIR@")
set(PACKAGING_PROJECT_SOURCE_DIR "@PACKAGING_PROJECT_SOURCE_DIR@")

# helper function to retrieve path values stored in STANDALONE_APP_PATHS,
# always preceded by their corresponding "key" PLUGIN_TARGET_NAME
function(_get_pair_value_from_key DICTLIST KEY OUT_VAR)
    list(FIND ${DICTLIST} ${KEY} index)
    if(index EQUAL -1)
        set(${OUT_VAR} "" PARENT_SCOPE) # Key not found
    else()
        math(EXPR value_index "${index} + 1")
        list(GET ${DICTLIST} ${value_index} value)
        set(${OUT_VAR} ${value} PARENT_SCOPE)
    endif()
endfunction()

function(_configure_files_for_standalone PLUGIN_TARGET_NAME
                                         USE_TARGET_FORMAT_COMPONENTS)
    # we set tmp STANDALONE_APP_PATH var to be consumed by the
    # FixStandaloneRelocatable.sh script generators
    _get_pair_value_from_key(
            STANDALONE_APP_PATHS
            "${PLUGIN_TARGET_NAME}"
            app_path
    )
    set(STANDALONE_APP_PATH ${app_path})

    configure_file(
            "${PACKAGING_SCRIPTS_DIR}/BundleNotRelocatable.plist.in"
            "${CMAKE_SOURCE_DIR}/${PLUGIN_TARGET_NAME}/BundleNotRelocatable.plist"
    )
    configure_file(
            "${PACKAGING_SCRIPTS_DIR}/FixStandaloneRelocatable.sh.in"
            "${CMAKE_SOURCE_DIR}/${PLUGIN_TARGET_NAME}/FixStandaloneRelocatable.sh"
            FILE_PERMISSIONS
            OWNER_READ OWNER_WRITE OWNER_EXECUTE
            GROUP_READ GROUP_EXECUTE
            WORLD_READ WORLD_EXECUTE
    )
endfunction()

if(USE_TARGET_FORMAT_COMPONENTS)
    foreach(PLUGIN_TARGET_NAME IN LISTS PLUGIN_TARGETS)
        _configure_files_for_standalone(
            ${PLUGIN_TARGET_NAME}
            USE_TARGET_FORMAT_COMPONENTS
        )
    endforeach()
else()
    _configure_files_for_standalone(
        ${PLUGIN_TARGET_NAME}
        USE_TARGET_FORMAT_COMPONENTS
  )
endif()

configure_file(
  "${PACKAGING_SCRIPTS_DIR}/FixAllStandalonesRelocatable.sh.in"
  "${CMAKE_SOURCE_DIR}/FixAllStandalonesRelocatable.sh"
  FILE_PERMISSIONS
  OWNER_READ OWNER_WRITE OWNER_EXECUTE
  GROUP_READ GROUP_EXECUTE
  WORLD_READ WORLD_EXECUTE
)
configure_file(
  "${PACKAGING_SCRIPTS_DIR}/Uninstall.applescript.in"
  "${CMAKE_SOURCE_DIR}/Uninstall.applescript"
)
configure_file(
  "${PACKAGING_SCRIPTS_DIR}/CreateDmg.sh.in"
  "${CMAKE_SOURCE_DIR}/CreateDmg.sh"
  FILE_PERMISSIONS
  OWNER_READ OWNER_WRITE OWNER_EXECUTE
  GROUP_READ GROUP_EXECUTE
  WORLD_READ WORLD_EXECUTE
)
configure_file(
  "${PACKAGING_SCRIPTS_DIR}/NotarizeDmg.sh.in"
  "${CMAKE_SOURCE_DIR}/NotarizeDmg.sh"
  FILE_PERMISSIONS
  OWNER_READ OWNER_WRITE OWNER_EXECUTE
  GROUP_READ GROUP_EXECUTE
  WORLD_READ WORLD_EXECUTE
)

################################################################################
# include cpack and add components

include(CPack)

if(USE_TARGET_FORMAT_COMPONENTS)
  foreach(PLUGIN_TARGET_NAME IN LISTS PLUGIN_TARGETS)
    foreach(FORMAT @FORMATS@)
      cpack_add_component("${PLUGIN_TARGET_NAME}_${FORMAT}"
        DISPLAY_NAME "${PLUGIN_TARGET_NAME} (${FORMAT})"
      )
    endforeach()
  endforeach()
else()
  foreach(FORMAT @FORMATS@)
    cpack_add_component(${FORMAT} DISPLAY_NAME "${FORMAT} Plugin")
  endforeach()
endif()

if(NOT "@PLUGIN_RESOURCES_DIR@" STREQUAL "")
  cpack_add_component("Resources" DISPLAY_NAME "Shared plugin data" REQUIRED)
endif()
