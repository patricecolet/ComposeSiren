# Normalize text files in the repo to LF to avoid ^M diffs
* text=auto eol=lf

# Keep Windows scripts as CRLF (so they run in cmd.exe without surprises)
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Patches keep their bytes: JUCE sources are CRLF (Dependencies/patches)
*.patch -text
